# 이 파일만 커밋한다. 실제 값은 .env 에 넣는다 (.env 는 .gitignore 에 있음)
ENV=dev
TIMEZONE=Asia/Seoul
DATABASE_URL=postgresql+psycopg://woowang:woowang@db:5432/woowang
POSTGRES_PASSWORD=woowang
PHOTO_DIR=/data/photos
# 사진 서명 URL용 비밀값. 운영에서는 긴 난수로 바꾼다
PHOTO_URL_SECRET=change-me

# 판독기: mock | claude | openai | ollama  (mock 이면 앱에 "모의 판독" 표시)
READER_LAYOUT=mock
READER_CELLS=mock

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# 정확도 비교용 (harness). 키는 여기(.env)에만 넣는다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

READER_TIMEOUT_S=60
DAILY_READING_LIMIT=30

# 재질문·인계 시간값 (앱이 GET /me 로 내려받음, R-007 C5)
REASK_OFFSETS_MIN=[10,20]
NO_RESPONSE_HANDOFF_MIN=30
RETAKE_WAIT_MIN=15

# PC 에서 api 를 여는 포트 (터널이 연결하는 포트). 다른 프로그램이 8000 을 쓰면 바꾼다
API_PORT=8000
# 앱에 내려주는 사진 URL 앞부분 (Cloudflare Tunnel 주소)
PUBLIC_BASE_URL=
# 시연 트리거. 심사용 서버에서만 true (R-010 10번)
DEMO_MODE=false
REFILL_THRESHOLD_DAYS=2
# 1분마다 복약 건 열기·무응답 인계·요약 푸시·정리
JOBS_ENABLED=true
# Expo 푸시 실제 발송 (false 면 로그만)
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
# 웹에서 앱을 열 때 허용할 출처 (쉼표 구분). 운영에서는 실제 웹 앱 주소만. * 는 ENV=dev 에서만
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
