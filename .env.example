# 이 파일만 커밋한다. 실제 값은 .env 에 넣는다 (.env 는 .gitignore 에 있음)
ENV=dev
TIMEZONE=Asia/Seoul
DATABASE_URL=postgresql+psycopg://woowang:woowang@db:5432/woowang
POSTGRES_PASSWORD=woowang
PHOTO_DIR=/data/photos
# 사진 서명 URL용 비밀값. 운영에서는 긴 난수로 바꾼다
PHOTO_URL_SECRET=change-me

# 판독기: mock | claude | openai | ollama  (mock 이면 앱에 "모의 판독" 표시)
READER_LAYOUT=mock
READER_CELLS=mock

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# 정확도 비교용 (harness). 키는 여기(.env)에만 넣는다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# 비우면 모델 기본 추론 강도. 판독 지연이 길면 low
OPENAI_REASONING_EFFORT=

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

READER_TIMEOUT_S=60
# 가족당 하루 판독 횟수 한도. 0 이면 제한 없음
DAILY_READING_LIMIT=0

# 재질문·인계 시간값 (앱이 GET /me 로 내려받음, R-007 C5)
REASK_OFFSETS_MIN=[10,20]
NO_RESPONSE_HANDOFF_MIN=30
RETAKE_WAIT_MIN=15

# PC 에서 api 를 여는 포트 (터널이 연결하는 포트). 다른 프로그램이 8000 을 쓰면 바꾼다
API_PORT=8000
# 앱에 내려주는 사진 URL 앞부분 (Cloudflare Tunnel 주소)
PUBLIC_BASE_URL=
# 시연 트리거. 심사용 서버에서만 true (R-010 10번)
DEMO_MODE=false
REFILL_THRESHOLD_DAYS=2
# 1분마다 복약 건 열기·무응답 인계·요약 푸시·정리
JOBS_ENABLED=true
# 보호자 푸시: fcm | expo | recording (recording 은 보내지 않고 로그만). 비우면 EXPO_PUSH_ENABLED 로 정함
PUSH_PROVIDER=
# FCM 서비스 계정 키 JSON 경로 (R-039). Docker 에서는 아래 SECRETS_DIR 이 /run/secrets/woowang 에 붙는다
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/woowang/fcm-service-account.json
# 서비스 계정 키가 있는 PC 폴더 (저장소 밖, 절대 경로). docker compose 가 읽기 전용으로 붙인다
SECRETS_DIR=
# 앱의 보호자 알림 채널 id (FE GUARDIAN_CHANNEL)
FCM_ANDROID_CHANNEL_ID=guardian-quiet
# (예전 방식) Expo 푸시. PUSH_PROVIDER 가 비었을 때만 본다
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
# 웹에서 앱을 열 때 허용할 출처 (쉼표 구분). 운영에서는 실제 웹 앱 주소만. * 는 ENV=dev 에서만
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
